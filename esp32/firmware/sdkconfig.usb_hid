# Native USB OTG, not the USB-to-UART bridge. Keep diagnostics on UART.
CONFIG_TASR_MODE_MIC=y
CONFIG_TASR_USB_HID=y
CONFIG_TASR_USB_BUTTON_GPIO=0
CONFIG_TASR_USB_LED_GPIO=-1
CONFIG_TASR_USB_REPORT_INTERVAL_MS=10
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_TASK_PRIORITY=24
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_TASK_STACK_SIZE=4096
CONFIG_TINYUSB_INIT_IN_DEFAULT_TASK=y
CONFIG_TINYUSB_MODE_SLAVE=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_MIDI_COUNT=0
CONFIG_TINYUSB_VENDOR_COUNT=0
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
